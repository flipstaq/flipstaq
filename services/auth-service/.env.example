# Database Configuration
DATABASE_URL=""

# JWT Configuration - Persistent Login Strategy
JWT_SECRET=""
JWT_ACCESS_TOKEN_EXPIRY="15m"  # Short-lived access token (15 minutes)
JWT_REFRESH_TOKEN_EXPIRY="30d" # Long-lived refresh token (30 days)
JWT_REFRESH_SECRET=""

# Server Configuration
PORT=3001
NODE_ENV="development"

# CORS Configuration
FRONTEND_URL="http://localhost:3000"

# Email Configuration (Resend)
RESEND_API_KEY="your_resend_api_key_here"
EMAIL_FROM="Flipstaq <noreply@yourplatform.com>"

# Rate Limiting Configuration
RATE_LIMIT_REFRESH_TOKENS="5_per_minute"
RATE_LIMIT_DEFAULT="10_per_minute"
