# Report Service Environment Variables

# Server Configuration
PORT=3009
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/flipstaq_dev"

# JWT Configuration - Persistent Login Strategy
JWT_SECRET="supersupersecretCEMal"
JWT_ACCESS_TOKEN_EXPIRY="15m"  # Short-lived access token
JWT_REFRESH_TOKEN_EXPIRY="30d" # Long-lived refresh token
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"



# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4000"

# API Gateway Configuration
API_GATEWAY_URL="http://localhost:4000"

# Logging
LOG_LEVEL=info
ENABLE_QUERY_LOGGING=false

# Export Configuration
MAX_EXPORT_RECORDS=10000
EXPORT_TIMEOUT_MS=30000

# Cache Configuration
CACHE_TTL_SECONDS=300

# Feature Flags
ENABLE_EXPORT_CSV=true
ENABLE_EXPORT_JSON=true
ENABLE_ADVANCED_SEARCH=true

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
