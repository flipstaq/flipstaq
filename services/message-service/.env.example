# Environment Variables for Message Service
DATABASE_URL=""
REDIS_URL="redis://localhost:6379"
PORT=3002

# JWT Configuration - Persistent Login Strategy (shared with other services)
JWT_SECRET=""
JWT_ACCESS_TOKEN_EXPIRY="15m"  # Short-lived access token
JWT_REFRESH_TOKEN_EXPIRY="30d" # Long-lived refresh token
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"

# Service Configuration
NODE_ENV="development"
